# ==========================================================
#  构建产物
# ==========================================================
entry/build/
entry/.preview/
entry/default/
**/build/
**/.cxx/
**/.cmake/
.hvigor/
node_modules/

# 依赖缓存（HarmonyOS 用 oh_modules，不是 node_modules）
oh_modules/

# 已签名的 HAP —— 内含开发者签名证书，绝不能进版本库
*.hap
*.hsp
*.har
*.app

# 原生编译产物
**/libs/
*.so
*.a

# ==========================================================
#  本地/临时文件
# ==========================================================
.tmp/
tmp/
shots/
local.properties
.DS_Store
Thumbs.db

# 脚本生成的中间文件
tools/_ets_transformed.mjs
tools/_wasmtest/

# ==========================================================
#  IDE
# ==========================================================
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ==========================================================
#  密钥与证书（以防万一，任何形态都排除）
# ==========================================================
*.p12
*.jks
*.keystore
*.cer
*.p7b
*.csr
*.pem
*.key
.env
.env.*
*.token

# ★★ 本地 API 密钥 —— 绝对不能提交
#   本仓库是公开的，GitHub 上扫 `sk-` 前缀的爬虫是分钟级的。
#   模板 LocalKey.ets.example 入库（保证 clone 能编译），
#   真实密钥填在 LocalKey.ets 里，由本行 + tools/pre-commit 双重保护。
LocalKey.ets
.apikey
!LocalKey.ets.example

# 会话/工具临时目录（含截图等中间产物），不入库
.workbuddy-ai/
.git-msg.tmp

# 旧协议代码备份（仅本地保险，不进版本库）
legacy_backup/
